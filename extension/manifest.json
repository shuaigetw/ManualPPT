{
  "manifest_version": 3,
  "name": "ManualPPT Browser Capture Extension",
  "version": "1.0.0",
  "description": "Chrome/Edge Extension for ManualPPT semantic DOM capture and local evidence recording.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.staging.internal/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.staging.internal/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
